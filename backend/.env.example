# Backend Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret

# Database URL
DATABASE_URL=sqlite:///righand.db

# Firebase Configuration (optional if using Firebase for auth)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# CORS Configuration
CORS_ORIGINS=*

# dbops-api purchase tracking webhook (optional)
DBOPS_WEBHOOK_URL=http://localhost:5001/api/webhooks/righand
DBOPS_WEBHOOK_SECRET=change-me-shared-with-righand

# Google Play product IDs (must match Play Console)
GOOGLE_PRODUCT_PRO=righand_pro_monthly
GOOGLE_PRODUCT_FLEET=righand_fleet_monthly

# Server Configuration
HOST=0.0.0.0
PORT=5000
